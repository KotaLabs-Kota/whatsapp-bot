# ---------------------------------------------------------------------------
# WhatsApp Business Cloud API + Google Gemini
# Copy this file:  cp .env.example .env   (then fill in the values)
# Never commit the real .env — it is git-ignored.
# ---------------------------------------------------------------------------

# Google AI Studio key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Meta WhatsApp Cloud API credentials (WhatsApp > API Setup in the dashboard)
# Temporary 24h token or a permanent System User token.
WHATSAPP_TOKEN=your_permanent_whatsapp_access_token_here
# "Phone number ID" (numeric) — NOT the phone number itself.
PHONE_NUMBER_ID=123456789012345

# Any random string you invent; must match the value you paste in the dashboard.
VERIFY_TOKEN=my_super_secret_verify_token

# HTTP port for the webhook server.
PORT=3000

# ---------------------------------------------------------------------------
# Optional settings (sane defaults shown — delete or leave blank to use them)
# ---------------------------------------------------------------------------

# App Secret from Meta > App settings > Basic. Strongly recommended in production:
# when set, every POST /webhook must carry a valid X-Hub-Signature-256 header.
# WHATSAPP_APP_SECRET=your_meta_app_secret

# Graph API version used for sending messages.
# GRAPH_API_VERSION=v25.0

# Gemini model to use.
# GEMINI_MODEL=gemini-2.5-flash

# Thinking budget for gemini-2.5-flash: 0 = fastest replies, -1 = automatic.
# GEMINI_THINKING_BUDGET=0

# Persona / behaviour of the assistant.
# SYSTEM_PROMPT=You are a friendly, helpful assistant chatting on WhatsApp.

# Conversation memory per WhatsApp number (turns = user+model pairs, TTL minutes).
# MAX_HISTORY_TURNS=20
# SESSION_TTL_MINUTES=30

# Show "typing…" and a blue double-tick as soon as a message arrives.
# SEND_READ_RECEIPTS=false

# Outbound HTTP timeout in milliseconds (Gemini + Graph API).
# REQUEST_TIMEOUT_MS=30000

# error | warn | info | debug
# LOG_LEVEL=info
